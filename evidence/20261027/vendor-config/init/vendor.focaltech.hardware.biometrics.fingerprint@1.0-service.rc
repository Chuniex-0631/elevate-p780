service vendor.focaltech.fps_hal /vendor/bin/hw/vendor.focaltech.hardware.biometrics.fingerprint@1.0-service
    # "class hal" causes a race condition on some devices due to files created
    # in /data. As a workaround, postpone startup until later in boot once
    # /data is mounted.
    class late_start
    user system
    group system input
    #lijian add a cpuset for the focal fingerprint
    ioprio rt 4
    writepid /dev/cpuset/fp-service/tasks /dev/stune/foreground/tasks
    rlimit rtprio 10 10
